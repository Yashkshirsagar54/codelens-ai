# ==============================================================================
# CodeLens AI - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# CLIENT-SAFE VARIABLES (Exposed to Vite frontend bundle)
# ------------------------------------------------------------------------------
# Clerk Publishable Key (from Clerk Dashboard > API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Sentry DSN for frontend error reporting (Optional in dev, recommended in prod)
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Backend API Base URL (leave empty in local dev to rely on Vite proxy /api)
VITE_API_BASE_URL=


# ------------------------------------------------------------------------------
# SERVER-ONLY SECRETS (NEVER exposed to client/browser bundle)
# ------------------------------------------------------------------------------
# Server Port (default 3001 for Express dev server)
PORT=3001

# Clerk Secret Key (from Clerk Dashboard > API Keys)
CLERK_SECRET_KEY=sk_test_...

# Clerk Webhook Endpoint Signing Secret (from Clerk Dashboard > Webhooks > Endpoint)
CLERK_WEBHOOK_SECRET=whsec_...

# Google Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=AIzaSy...

# Google Gemini Model Identifier (e.g., gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Supabase Postgres Database Connection String (Transaction Pooler - Port 6543)
# Used at runtime by serverless API functions to avoid connection exhaustion.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase Direct Database Connection String (Direct Session - Port 5432)
# Used exclusively for DDL database migrations (db/migrate.ts) to support locks.
DIRECT_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].supabase.co:5432/postgres

# Server Sentry DSN (Optional in dev, recommended in prod)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
